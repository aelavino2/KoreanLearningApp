<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.SavedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    x:DataType="vm:SavedViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,18,24,4" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource LogoBadgeStyle}">
                <Image Source="logo_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="Saved" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding SavedWords.Count, StringFormat='{0} saved words'}" Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Margin="24,10,24,0">

            <CollectionView
                x:Name="SavedCollectionView"
                ItemsSource="{Binding SavedWords}"
                SelectionMode="None"
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SavedWordItemViewModel">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Korean}" Style="{StaticResource WordKoreanStyle}" />

                                    <Label Text="{Binding Ru}" FontSize="13" TextColor="{StaticResource ColorMuted}" />

                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource TagPillBorderStyle}">
                                            <HorizontalStackLayout Spacing="6">
                                                <Ellipse Style="{StaticResource TagPillDotStyle}" />
                                                <Label Text="{Binding PartOfSpeechDisplay}" Style="{StaticResource TagPillLabelStyle}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Border BackgroundColor="{StaticResource ColorChipBg}"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="8,3"
                                                IsVisible="{Binding HasTopikLevel}">
                                            <Label Text="{Binding TopikLevel, StringFormat='TOPIK {0}'}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource ColorPrimaryDark}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border Grid.Column="1" Style="{StaticResource RoundIconButtonStyle}" VerticalOptions="Center">
                                    <Image Source="star_filled_icon.png" WidthRequest="16" HeightRequest="16" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference SavedCollectionView}, Path=BindingContext.RemoveFromSavedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="Пока нет сохранённых слов" FontSize="14" TextColor="{StaticResource ColorMuted}" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>

        <Border Grid.Row="2" Style="{StaticResource TabBarBorderStyle}">
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="words_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Words" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToWordsCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="practice_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Practice" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPracticeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="import_export_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Import" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToImportExportCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="star_icon_active.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Saved" Style="{StaticResource TabIconLabelActiveStyle}" Margin="0,4,0,0" />
                    <BoxView Grid.Row="0" WidthRequest="4" HeightRequest="4" CornerRadius="2" BackgroundColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-8" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSavedCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>