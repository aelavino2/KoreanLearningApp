<?xml version="1.0" encoding="utf-8" ?>
<!--
    ContentPage — корневая страница.
    x:DataType задаёт тип ViewModel для compiled bindings (быстрее, чем обычные string-биндинги,
    и ошибки в именах свойств ловятся на этапе компиляции, а не в рантайме).
-->
<ContentPage
    x:Class="KoreanLearningApp.Views.WordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    xmlns:conv="clr-namespace:KoreanLearningApp.Converters"
    x:DataType="vm:WordsViewModel"
    Title="Agricultural Dictionary"
    BackgroundColor="#F2F7F3">

    <!--
        Grid с двумя строками: сверху поиск (фиксированная высота "Auto"),
        снизу список (занимает всё оставшееся место — "*")
    -->
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">

        <!-- ================= ПОИСК ================= -->
        <Border
            Grid.Row="0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 20"
            Stroke="Transparent"
            Padding="16,10">
            <Grid ColumnDefinitions="Auto,*">
                <Label
                    Grid.Column="0"
                    Text="&#xF002;"
                    FontFamily="MaterialIcons"
                    VerticalOptions="Center"
                    TextColor="#8FA894"
                    Margin="0,0,10,0" />

                <!--
                    Text биндится к SearchText в ViewModel двусторонне (TwoWay — режим по умолчанию для Entry),
                    т.е. при вводе в поле VM.SearchText обновляется автоматически и запускает фильтрацию
                -->
                <Entry
                    Grid.Column="1"
                    Placeholder="Search for Words"
                    Text="{Binding SearchText}"
                    BackgroundColor="Transparent" />
            </Grid>
        </Border>

        <!-- ================= СПИСОК СЛОВ ================= -->
        <!--
            CollectionView — основной элемент для списков в MAUI (замена ListView).
            ItemsSource — откуда брать данные, SelectionMode отключаем, т.к. выбор не нужен.
        -->
        <CollectionView
            Grid.Row="1"
            x:Name="WordsCollectionView"
            ItemsSource="{Binding Words}"
            SelectionMode="None">

            <!--
                ItemsLayout задаёт раскладку элементов.
                Span="1" — по умолчанию одна колонка (мобильный вид).
                Реальное число колонок для ПК/широких экранов меняется из code-behind (см. .cs файл)
                в зависимости от ширины окна — это и даёт "адаптивность".
            -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <!--
                ItemTemplate — как рисуется КАЖДЫЙ элемент списка.
                x:DataType здесь — WordItemViewModel, а не WordsViewModel (мы теперь "внутри" одного элемента списка)
            -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WordItemViewModel">

                    <!-- Border вместо Frame — современный способ рисовать карточки с скруглением в MAUI -->
                    <Border
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent"
                        Padding="16,14">

                        <!-- Тень для карточки — лёгкая, чтобы список "дышал" -->
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.06" Radius="8" Offset="0,2" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                            <!-- Иконка слева (условная — категория/тип слова) -->
                            <Label
                                Grid.Column="0"
                                Text="&#xF06C;"
                                FontFamily="MaterialIcons"
                                FontSize="20"
                                TextColor="#4CAF50"
                                VerticalOptions="Center" />

                            <!-- Само слово: заголовок + подпись категории под ним -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Korean}" FontSize="16" FontAttributes="Bold" TextColor="#1B2E1F" />
                                <Label Text="{Binding Category}" FontSize="12" TextColor="#8FA894" />
                            </VerticalStackLayout>

                            <!--
                                Кнопка "избранное": ImageButton с командой ToggleFavoriteCommand,
                                текст-иконка меняется через конвертер в зависимости от IsFavorite
                            -->
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>