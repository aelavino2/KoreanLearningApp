<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
             x:Class="KoreanLearningApp.Views.WordsPage"
             Title="Корейские слова"
             BackgroundColor="#FBF7F0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#2B2B2B</Color>
            <Color x:Key="JadeColor">#2E6F65</Color>
            <Color x:Key="PersimmonColor">#D64545</Color>
            <Color x:Key="GoldColor">#C9A227</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="MutedColor">#8A8378</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20,16" RowSpacing="16">

        <!-- Переключатель направления + перемешивание -->
        <HorizontalStackLayout Grid.Row="0" Spacing="12" HorizontalOptions="Center">
            <Border Stroke="{StaticResource JadeColor}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 24"
                BackgroundColor="{StaticResource CardColor}"
                Padding="4">
                <Button x:Name="DirectionButton"
                    Text="🇰🇷 → 🇷🇺"
                    Clicked="OnToggleDirectionClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource JadeColor}"
                    FontAttributes="Bold"
                    FontSize="16"
                    Padding="16,8" />
            </Border>

            <Border Stroke="{StaticResource GoldColor}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 24"
                BackgroundColor="{StaticResource CardColor}"
                Padding="4">
                <Button Text="🔀 Перемешать"
                    Clicked="OnShuffleClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource GoldColor}"
                    FontAttributes="Bold"
                    FontSize="16"
                    Padding="16,8" />
            </Border>

            <Border Stroke="{StaticResource PersimmonColor}"
        StrokeThickness="1.5"
        StrokeShape="RoundRectangle 24"
        BackgroundColor="{StaticResource CardColor}"
        Padding="4">
                <Button Text="🧩 JSON"
            Clicked="OnImportExportClicked"
            BackgroundColor="Transparent"
            TextColor="{StaticResource PersimmonColor}"
            FontAttributes="Bold"
            FontSize="16"
            Padding="16,8" />
            </Border>
        </HorizontalStackLayout>

        <!-- Список карточек -->
        <CollectionView Grid.Row="1"
                     ItemsSource="{Binding Cards}"
                     SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WordCardViewModel">
                    <Border BackgroundColor="{StaticResource CardColor}"
                        Stroke="#EAE3D6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.06" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <Grid Padding="20,18" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                   Text="{Binding Number}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource JadeColor}"
                                   VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                   Text="{Binding FrontText}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource InkColor}" />
                            </Grid>

                            <Label Grid.Row="1"
                               Text="{Binding TranscriptionText}"
                               FontSize="14"
                               TextColor="{StaticResource MutedColor}"
                               FontAttributes="Italic" />

                            <Grid Grid.Row="2">
                                <Button Text="Показать перевод"
                                    Clicked="OnRevealClicked"
                                    IsVisible="{Binding ShowButton}"
                                    BackgroundColor="{StaticResource GoldColor}"
                                    TextColor="White"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    HorizontalOptions="Start" />

                                <Label Text="{Binding BackText}"
                                   IsVisible="{Binding IsRevealed}"
                                   FontSize="20"
                                   TextColor="{StaticResource PersimmonColor}"
                                   FontAttributes="Bold" />
                            </Grid>

                            <Button Grid.Row="3"
                                Text="📖 Правило"
                                Clicked="OnRuleClicked"
                                IsVisible="{Binding HasRule}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource JadeColor}"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="0"
                                HorizontalOptions="Start" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Плавающая кнопка добавления -->
        <Border Grid.Row="1"
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,8,8"
            WidthRequest="58"
            HeightRequest="58"
            StrokeShape="RoundRectangle 29"
            BackgroundColor="{StaticResource JadeColor}">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.2" Radius="10" Offset="0,4" />
            </Border.Shadow>
            <Button Text="+"
                FontSize="30"
                TextColor="White"
                BackgroundColor="Transparent"
                Clicked="OnAddClicked" />
        </Border>

    </Grid>
</ContentPage>