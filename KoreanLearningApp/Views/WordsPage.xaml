<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.WordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    x:DataType="vm:WordsViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">


        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,18,24,4" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource LogoBadgeStyle}">
                <Image Source="logo_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="Korean Dictionary" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding Words.Count, StringFormat='{0} words on this page'}" Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>
        </Grid>


        <Border Grid.Row="1" Margin="24,14,24,14" Style="{StaticResource SearchBarBorderStyle}">
            <Grid ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" Source="search_icon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" Margin="0,0,10,0" />
                <Entry Grid.Column="1" Placeholder="Search for Words" Text="{Binding SearchText}" Style="{StaticResource SearchEntryStyle}" />
            </Grid>
        </Border>


        <CollectionView Grid.Row="2"
                x:Name="WordsCollectionView"
                ItemsSource="{Binding Words}"
                SelectionMode="None"
                Margin="24,0,24,0"
                RemainingItemsThreshold="0"
                RemainingItemsThresholdReachedCommand="{Binding ScrolledToEndCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
<DataTemplate x:DataType="vm:WordItemViewModel">
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Label Text="{Binding Korean}" Style="{StaticResource WordKoreanStyle}" />
                <HorizontalStackLayout Spacing="6">
                    <Border Style="{StaticResource TagPillBorderStyle}">
                        <HorizontalStackLayout Spacing="6">
                            <Ellipse Style="{StaticResource TagPillDotStyle}" />
                            <Label Text="{Binding PartOfSpeechDisplay}" Style="{StaticResource TagPillLabelStyle}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="{StaticResource ColorChipBg}"
                            StrokeShape="RoundRectangle 10"
                            Padding="8,3"
                            IsVisible="{Binding HasTopikLevel}">
                        <Label Text="{Binding TopikLevel, StringFormat='TOPIK {0}'}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorPrimaryDark}" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border Grid.Column="1" Style="{StaticResource RoundIconButtonStyle}" VerticalOptions="Center">
                <Image Source="chevron_right_icon.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference WordsCollectionView}, Path=BindingContext.OpenWordDetailCommand}"
                CommandParameter="{Binding Word}" />
        </Border.GestureRecognizers>
    </Border>
</DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Padding="24,10,24,10" IsVisible="{Binding IsPaginationVisible}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="&#8592;"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoToPreviousPage}"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        FontSize="16" CornerRadius="13"
                        BackgroundColor="{StaticResource ColorChipBg}"
                        TextColor="{StaticResource ColorPrimaryDark}" />

                <Label Grid.Column="1"
                       Text="{Binding PageIndicatorText}"
                       TextColor="{StaticResource ColorPrimaryDark}"
                       FontSize="14" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />

                <Button Grid.Column="2"
                        Text="&#8594;"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        FontSize="16" CornerRadius="13"
                        BackgroundColor="{StaticResource ColorPrimary}"
                        TextColor="White" />
            </Grid>

            <Label Grid.Row="1"
                   Text="Долистайте список до конца, чтобы перейти дальше"
                   FontSize="11" TextColor="{StaticResource ColorMuted}"
                   HorizontalOptions="Center" Margin="0,6,0,0"
                   IsVisible="{Binding CanGoToNextPage, Converter={StaticResource InverseBoolConverter}}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource TabBarBorderStyle}">
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="words_icon_active.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Words" Style="{StaticResource TabIconLabelActiveStyle}" />
                    <BoxView Grid.Row="0" WidthRequest="4" HeightRequest="4" CornerRadius="2" BackgroundColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-8" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToWordsCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="practice_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Practice" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPracticeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="import_export_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Import" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToImportExportCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="star_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Saved" Style="{StaticResource TabIconLabelStyle}" Margin="0,4,0,0" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSavedCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
