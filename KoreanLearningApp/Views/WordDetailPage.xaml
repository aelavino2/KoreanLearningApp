<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.WordDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    x:DataType="vm:WordDetailViewModel"
    BackgroundColor="#F2F5F0"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20,20,20,8" ColumnSpacing="12">
            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" Stroke="Transparent" BackgroundColor="Transparent" Padding="0">
                <Image Source="back_icon.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="16">

                <Border BackgroundColor="White" StrokeShape="RoundRectangle 20" Stroke="Transparent" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.05" Radius="10" Offset="0,2" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#EAF6EA" Stroke="Transparent" Padding="10,4" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="6">
                                    <Ellipse Fill="Green" WidthRequest="6" HeightRequest="6" VerticalOptions="Center" />
                                    <Label Text="{Binding PartOfSpeechDisplay}" TextColor="Green" FontSize="13" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Text="{Binding Word.Korean}" FontSize="32" FontAttributes="Bold" TextColor="#1B2E1F" />
                            <Label Text="{Binding PrimaryTranslation}" FontSize="16" TextColor="#4CAF50" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Word.TopikLevel}" FontSize="13" TextColor="#8FA894" VerticalOptions="Start" />
                    </Grid>
                </Border>

                <Label Text="TRANSLATIONS &amp; MEANINGS" FontSize="12" FontAttributes="Bold" TextColor="#8FA894" Margin="4,4,0,0" />

                <CollectionView ItemsSource="{Binding Senses}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SenseItemViewModel">
                            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="16,14">
                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.05" Radius="8" Offset="0,2" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding EnText}" FontSize="16" FontAttributes="Bold" TextColor="#1B2E1F" VerticalOptions="Center" />
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F0F0F0" Stroke="Transparent" Padding="10,4">
                                            <Label Text="Examples" FontSize="13" TextColor="#1B2E1F" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsExpanded}">
                                        <Label Text="{Binding EnDefinition}" FontSize="13" TextColor="#4C5C4F" />
                                        <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" Margin="0,4" />
                                        <Label Text="{Binding RuText}" FontSize="14" FontAttributes="Bold" TextColor="#1B2E1F" />
                                        <Label Text="{Binding RuDefinition}" FontSize="13" TextColor="#4C5C4F" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>