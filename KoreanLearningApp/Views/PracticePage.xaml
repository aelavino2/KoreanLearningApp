<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.PracticePage"
    x:Name="PracticePageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    x:DataType="vm:PracticeViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="24,18,24,4" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource LogoBadgeStyle}">
                <Image Source="logo_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="Квиз" Style="{StaticResource PageTitleStyle}" />
                <Label Text="Настройте параметры квиза" Style="{StaticResource PageSubtitleStyle}"
                       IsVisible="{Binding IsSessionActive, Converter={StaticResource InverseBoolConverter}}" />
                <Label Text="{Binding QuestionProgressText}" Style="{StaticResource PageSubtitleStyle}"
                       IsVisible="{Binding IsSessionActive}" />
            </VerticalStackLayout>

            <!-- Счёт очков виден только во время активной сессии -->
            <Border Grid.Column="2" Style="{StaticResource TagPillBorderStyle}" IsVisible="{Binding IsSessionActive}" VerticalOptions="Center">
                <Label Text="{Binding Score, StringFormat='⭐ {0}'}" Style="{StaticResource TagPillLabelStyle}" FontAttributes="Bold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,0">

            <!-- ЭКРАН НАСТРОЕК: количество слов, уровни TOPIK, направление квиза, сохранённые слова -->
            <ScrollView IsVisible="{Binding IsSessionActive, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="22" Padding="0,10,0,20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="КОЛИЧЕСТВО СЛОВ" Style="{StaticResource SectionLabelStyle}" />
                        <Picker ItemsSource="{Binding WordCountOptions}" SelectedItem="{Binding WordCount}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="УРОВЕНЬ TOPIK" Style="{StaticResource SectionLabelStyle}" />
                        <Label Text="Ничего не выбрано — берём слова всех уровней" FontSize="11" TextColor="{StaticResource ColorMuted}" />
                        <HorizontalStackLayout Spacing="20">
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding IsTopik1Selected}" Color="{StaticResource ColorPrimary}" />
                                <Label Text="TOPIK 1" VerticalOptions="Center" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding IsTopik2Selected}" Color="{StaticResource ColorPrimary}" />
                                <Label Text="TOPIK 2" VerticalOptions="Center" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <CheckBox IsChecked="{Binding IsTopik3Selected}" Color="{StaticResource ColorPrimary}" />
                                <Label Text="TOPIK 3" VerticalOptions="Center" FontSize="13" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="НАПРАВЛЕНИЕ ВОПРОСА" Style="{StaticResource SectionLabelStyle}" />
                        <VerticalStackLayout Spacing="4">
                            <RadioButton Content="Корейское слово → выбрать русский перевод"
                                         GroupName="QuizDirection"
                                         IsChecked="{Binding IsKoreanToRuDirection}"
                                         FontSize="13" />
                            <RadioButton Content="Русский перевод → выбрать корейское слово"
                                         GroupName="QuizDirection"
                                         IsChecked="{Binding IsRuToKoreanDirection}"
                                         FontSize="13" />
                            <RadioButton Content="Случайно на каждый вопрос"
                                         GroupName="QuizDirection"
                                         IsChecked="{Binding IsRandomDirection}"
                                         FontSize="13" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Сохранённые слова" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Если включено — идут первыми в сессии, приоритетнее due и новых"
                                       FontSize="11" TextColor="{StaticResource ColorMuted}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IncludeSavedWords}"
                                    OnColor="{StaticResource ColorPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Button Text="Начать квиз"
                            Command="{Binding StartPracticeCommand}"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="White"
                            HeightRequest="48"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                        Color="{StaticResource ColorPrimary}" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- АКТИВНАЯ СЕССИЯ: один вопрос квиза за раз -->
            <Grid IsVisible="{Binding IsSessionActive}" RowDefinitions="Auto,Auto,*" RowSpacing="14">

                <Button Grid.Row="0"
                        Text="⚙ Изменить настройки"
                        Command="{Binding BackToSetupCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ColorMuted}"
                        FontSize="12"
                        HorizontalOptions="Start"
                        Padding="0"
                        Margin="0,0,0,4" />

                <!-- Таймер на текущий вопрос -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                      IsVisible="{Binding HasActiveQuestion}">
                    <ProgressBar Grid.Column="0" Progress="{Binding CurrentCard.TimeProgress}"
                                 ProgressColor="{Binding CurrentCard.TimerColor}" VerticalOptions="Center" HeightRequest="8" />
                    <Label Grid.Column="1" Text="{Binding CurrentCard.TimeLeft, StringFormat='{0} с'}"
                           TextColor="{Binding CurrentCard.TimerColor}"
                           FontSize="13" FontAttributes="Bold" WidthRequest="34" VerticalOptions="Center" />
                </Grid>

                <!-- Вопрос + 4 варианта ответа -->
                <ScrollView Grid.Row="2" IsVisible="{Binding HasActiveQuestion}">
                    <Grid x:Name="QuizCardRoot" BindingContext="{Binding CurrentCard}" x:DataType="vm:PracticeCardViewModel"
                          RowDefinitions="Auto,Auto,Auto" RowSpacing="18" Padding="0,4,0,20">

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TagPillBorderStyle}" IsVisible="{Binding IsNew}">
                                    <Label Text="новое" Style="{StaticResource TagPillLabelStyle}" FontSize="10" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TagPillBorderStyle}" IsVisible="{Binding IsNew, Converter={StaticResource InverseBoolConverter}}">
                                    <Label Text="{Binding PartOfSpeechDisplay}" Style="{StaticResource TagPillLabelStyle}" FontSize="10" />
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource RoundIconButtonStyle}"
                                        WidthRequest="28" HeightRequest="28"
                                        IsEnabled="{Binding IsSaveBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image Source="star_icon.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                                               IsVisible="{Binding IsSaved, Converter={StaticResource InverseBoolConverter}}" />
                                        <Image Source="star_filled_icon.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                                               IsVisible="{Binding IsSaved}" />
                                        <ActivityIndicator IsRunning="{Binding IsSaveBusy}" IsVisible="{Binding IsSaveBusy}"
                                                            Color="{StaticResource ColorPrimary}" WidthRequest="14" HeightRequest="14" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSaveCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding QuestionText}"
                                       FontSize="28" FontAttributes="Bold"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       Margin="0,6,0,0" />
                            </Grid>
                        </Border>

                        <Label Grid.Row="1" Text="Выберите правильный перевод" FontSize="12"
                               TextColor="{StaticResource ColorMuted}" HorizontalOptions="Center" />

                        <VerticalStackLayout Grid.Row="2" Spacing="10"
                                              IsEnabled="{Binding IsAnswered, Converter={StaticResource InverseBoolConverter}}"
                                              BindableLayout.ItemsSource="{Binding Options}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnswerOptionViewModel">
                                    <Border Padding="14,12" StrokeThickness="2" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{Binding State, Converter={StaticResource AnswerStateColorConverter}, ConverterParameter=Background}"
                                            Stroke="{Binding State, Converter={StaticResource AnswerStateColorConverter}, ConverterParameter=Stroke}">
                                        <Label Text="{Binding Text}" FontSize="16" HorizontalOptions="Center"
                                               TextColor="{Binding State, Converter={StaticResource AnswerStateColorConverter}, ConverterParameter=Text}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference QuizCardRoot}, Path=BindingContext.SelectAnswerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </Grid>
                </ScrollView>

                <!-- ЭКРАН РЕЗУЛЬТАТОВ: показывается, когда вопросы сессии закончились -->
                <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsSessionComplete}"
                                      VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="Квиз завершён!" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding Score, StringFormat='Очки: {0}'}" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="{Binding ResultsSummaryText}" FontSize="14" TextColor="{StaticResource ColorMuted}" HorizontalOptions="Center" />
                    <Button Text="Пройти ещё раз"
                            Command="{Binding BackToSetupCommand}"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="White"
                            HeightRequest="44"
                            WidthRequest="200"
                            Margin="0,14,0,0" />
                </VerticalStackLayout>

                <!-- Пустая сессия (нет доступных слов) -->
                <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="Пока нечего повторять" FontSize="14" TextColor="{StaticResource ColorMuted}" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>

        </Grid>

        <Border Grid.Row="2" Style="{StaticResource TabBarBorderStyle}">
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="words_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Words" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToWordsCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="practice_icon_active.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Practice" Style="{StaticResource TabIconLabelActiveStyle}" />
                    <BoxView Grid.Row="0" WidthRequest="4" HeightRequest="4" CornerRadius="2" BackgroundColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-8" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPracticeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="import_export_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Import" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToImportExportCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="star_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Saved" Style="{StaticResource TabIconLabelStyle}" Margin="0,4,0,0" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSavedCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
