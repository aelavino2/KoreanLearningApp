<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoreanLearningApp.Views.QuizPage" x:Name="RootPage" Title="Проверка знаний" BackgroundColor="#FBF7F0">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#2B2B2B</Color>
            <Color x:Key="JadeColor">#2E6F65</Color>
            <Color x:Key="PersimmonColor">#D64545</Color>
            <Color x:Key="GoldColor">#C9A227</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="MutedColor">#8A8378</Color>
            <Color x:Key="BadgeColor">#F0EBE0</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Padding="20,16" RowSpacing="14">

            <Label Grid.Row="0" Text="{Binding ProgressText}" FontSize="14" TextColor="{StaticResource MutedColor}" HorizontalOptions="Center" />

            <ProgressBar Grid.Row="1" Progress="{Binding TimerProgress}" ProgressColor="{StaticResource JadeColor}" HeightRequest="10">
                <ProgressBar.Triggers>
                    <DataTrigger TargetType="ProgressBar" Binding="{Binding IsTimeRunningOut}" Value="True">
                        <Setter Property="ProgressColor" Value="{StaticResource PersimmonColor}" />
                    </DataTrigger>
                </ProgressBar.Triggers>
            </ProgressBar>

            <HorizontalStackLayout Grid.Row="2" Spacing="16" HorizontalOptions="Center">
                <Label Text="{Binding ScoreText}" FontSize="14" TextColor="{StaticResource JadeColor}" FontAttributes="Bold" />
                <Label Text="{Binding BoxText}" FontSize="14" TextColor="{StaticResource MutedColor}" />
            </HorizontalStackLayout>

            <Border Grid.Row="3" BackgroundColor="{StaticResource CardColor}" Stroke="#EAE3D6" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="24,32">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.06" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Label Text="{Binding QuestionText}" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource InkColor}" HorizontalOptions="Center" />
            </Border>

            <Grid Grid.Row="4" IsVisible="{Binding IsNormalMode}" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="{Binding Options[0].Text}" IsVisible="{Binding Options[0].IsVisible}" Command="{Binding OptionCommand}" CommandParameter="{Binding Options[0]}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[0].IsCorrectAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[0].IsWrongAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PersimmonColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" Text="{Binding Options[1].Text}" IsVisible="{Binding Options[1].IsVisible}" Command="{Binding OptionCommand}" CommandParameter="{Binding Options[1]}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[1].IsCorrectAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[1].IsWrongAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PersimmonColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" Text="{Binding Options[2].Text}" IsVisible="{Binding Options[2].IsVisible}" Command="{Binding OptionCommand}" CommandParameter="{Binding Options[2]}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[2].IsCorrectAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[2].IsWrongAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PersimmonColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Text="{Binding Options[3].Text}" IsVisible="{Binding Options[3].IsVisible}" Command="{Binding OptionCommand}" CommandParameter="{Binding Options[3]}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[3].IsCorrectAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Options[3].IsWrongAnswer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PersimmonColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Сложный режим: написание с клавиатурой хангыля -->
            <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsHardMode}" Spacing="12">

                <Border BackgroundColor="{StaticResource BadgeColor}" StrokeShape="RoundRectangle 12" Padding="16,14">
                    <Label Text="{Binding TypedAnswerText}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource InkColor}" HorizontalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsTypedCorrect}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource JadeColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsTypedWrong}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource PersimmonColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Label Text="Начальная согласная" FontSize="12" TextColor="{StaticResource MutedColor}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding ChoKeys}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding .}" Command="{Binding BindingContext.ChoKeyCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" WidthRequest="46" HeightRequest="46" Margin="3" Padding="0" FontSize="16" CornerRadius="10" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Гласная" FontSize="12" TextColor="{StaticResource MutedColor}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding JungKeys}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding .}" Command="{Binding BindingContext.JungKeyCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" WidthRequest="46" HeightRequest="46" Margin="3" Padding="0" FontSize="16" CornerRadius="10" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Конечная согласная (받침, необязательно)" FontSize="12" TextColor="{StaticResource MutedColor}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding JongKeys}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding .}" Command="{Binding BindingContext.JongKeyCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" WidthRequest="46" HeightRequest="46" Margin="3" Padding="0" FontSize="16" CornerRadius="10" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Слог" Command="{Binding CommitSyllableCommand}" BackgroundColor="{StaticResource GoldColor}" TextColor="White" CornerRadius="10" HeightRequest="44" />
                    <Button Grid.Column="1" Text="Пробел" Command="{Binding SpaceCommand}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" CornerRadius="10" HeightRequest="44" />
                    <Button Grid.Column="2" Text="⌫" Command="{Binding BackspaceCommand}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource PersimmonColor}" CornerRadius="10" HeightRequest="44" />
                </Grid>

                <Button Text="Проверить" Command="{Binding SubmitAnswerCommand}" BackgroundColor="{StaticResource JadeColor}" TextColor="White" CornerRadius="12" HeightRequest="50" Margin="0,8,0,0" />

            </VerticalStackLayout>

            <Button Grid.Row="5" Text="Завершить" Command="{Binding FinishCommand}" BackgroundColor="Transparent" TextColor="{StaticResource PersimmonColor}" FontSize="14" HorizontalOptions="Center" Margin="0,8,0,0" />

        </Grid>
    </ScrollView>
</ContentPage>
