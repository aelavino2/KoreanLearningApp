<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoreanLearningApp.Views.QuizPage" Title="Проверка знаний" BackgroundColor="#FBF7F0">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#2B2B2B</Color>
            <Color x:Key="JadeColor">#2E6F65</Color>
            <Color x:Key="PersimmonColor">#D64545</Color>
            <Color x:Key="GoldColor">#C9A227</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="MutedColor">#8A8378</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20,16" RowSpacing="16">
        <Label Grid.Row="0" x:Name="ProgressLabel" Text="Вопрос 1 из 10" FontSize="14" TextColor="{StaticResource MutedColor}" HorizontalOptions="Center" />
        <ProgressBar Grid.Row="1" x:Name="TimerBar" Progress="1" ProgressColor="{StaticResource JadeColor}" HeightRequest="10" />

        <HorizontalStackLayout Grid.Row="2" Spacing="16" HorizontalOptions="Center">
            <Label x:Name="ScoreLabel" Text="Правильно: 0" FontSize="14" TextColor="{StaticResource JadeColor}" FontAttributes="Bold" />
            <Label x:Name="BoxLabel" Text="Коробка 1" FontSize="14" TextColor="{StaticResource MutedColor}" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="20" VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource CardColor}" Stroke="#EAE3D6" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="24,32">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.06" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Label x:Name="QuestionLabel" Text="안녕하세요" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource InkColor}" HorizontalOptions="Center" />
            </Border>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                <Button x:Name="Option1Button" Grid.Row="0" Grid.Column="0" Clicked="OnOptionClicked" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap" />
                <Button x:Name="Option2Button" Grid.Row="0" Grid.Column="1" Clicked="OnOptionClicked" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap" />
                <Button x:Name="Option3Button" Grid.Row="1" Grid.Column="0" Clicked="OnOptionClicked" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap" />
                <Button x:Name="Option4Button" Grid.Row="1" Grid.Column="1" Clicked="OnOptionClicked" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource InkColor}" FontSize="15" CornerRadius="12" HeightRequest="60" Padding="8" LineBreakMode="WordWrap" />
            </Grid>
        </VerticalStackLayout>
        <Button Grid.Row="4" Text="Завершить" Clicked="OnFinishClicked" BackgroundColor="Transparent" TextColor="{StaticResource PersimmonColor}" FontSize="14" HorizontalOptions="Center" />
    </Grid>
</ContentPage>