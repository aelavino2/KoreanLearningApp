<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoreanLearningApp.Views.QuizSettingsPage" Title="Настройка проверки" BackgroundColor="#FBF7F0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#2B2B2B</Color>
            <Color x:Key="JadeColor">#2E6F65</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="MutedColor">#8A8378</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Label Text="Сложность" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource InkColor}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="NormalButton" Grid.Column="0" Text="Обычный" Clicked="OnNormalClicked" BackgroundColor="{StaticResource JadeColor}" TextColor="White" CornerRadius="14" HeightRequest="70" />
                <Button x:Name="HardButton" Grid.Column="1" Text="Сложный" Clicked="OnHardClicked" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource JadeColor}" CornerRadius="14" HeightRequest="70" />
            </Grid>

            <Label x:Name="DifficultyDescriptionLabel" FontSize="13" TextColor="{StaticResource MutedColor}" Text="Выбор перевода из четырёх вариантов." />

            <BoxView HeightRequest="1" BackgroundColor="#EAE3D6" Margin="0,8" />

            <Label Text="Количество слов" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource InkColor}" />

            <Label x:Name="CountLabel" Text="10 слов" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource JadeColor}" HorizontalOptions="Center" />

            <Slider x:Name="CountSlider" Minimum="1" Maximum="30" Value="10" ValueChanged="OnCountChanged" MinimumTrackColor="{StaticResource JadeColor}" ThumbColor="{StaticResource JadeColor}" />

            <Button Text="Начать" Clicked="OnStartClicked" BackgroundColor="{StaticResource JadeColor}" TextColor="White" CornerRadius="14" HeightRequest="52" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>