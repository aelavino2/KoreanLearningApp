<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoreanLearningApp.Views.QuizSettingsPage" Title="Настройка проверки" BackgroundColor="#FBF7F0">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="InkColor">#2B2B2B</Color>
            <Color x:Key="JadeColor">#2E6F65</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="MutedColor">#8A8378</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <Label Text="Сложность" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource InkColor}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Обычный" Command="{Binding SelectNormalCommand}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource JadeColor}" CornerRadius="14" HeightRequest="70">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsNormalSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Сложный" Command="{Binding SelectHardCommand}" BackgroundColor="{StaticResource CardColor}" TextColor="{StaticResource JadeColor}" CornerRadius="14" HeightRequest="70">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsHardSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource JadeColor}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <Label Text="{Binding DifficultyDescriptionText}" FontSize="13" TextColor="{StaticResource MutedColor}" />
            <BoxView HeightRequest="1" BackgroundColor="#EAE3D6" Margin="0,8" />
            <Label Text="Количество слов" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource InkColor}" />
            <Label Text="{Binding CountText}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource JadeColor}" HorizontalOptions="Center" />
            <Slider Minimum="1" Maximum="30" Value="{Binding WordCount}" MinimumTrackColor="{StaticResource JadeColor}" ThumbColor="{StaticResource JadeColor}" />
            <Button Text="Начать" Command="{Binding StartCommand}" BackgroundColor="{StaticResource JadeColor}" TextColor="White" CornerRadius="14" HeightRequest="52" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
