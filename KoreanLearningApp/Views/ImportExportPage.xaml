<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KoreanLearningApp.Views.ImportExportPage"
             Title="Импорт / Экспорт слов"
             BackgroundColor="#FBF7F0">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Добавить новые слова (JSON)" FontAttributes="Bold" FontSize="16" TextColor="#2B2B2B" />
            <Label Text="Вставьте JSON-массив слов, сгенерированный ИИ. Точные дубликаты (то же слово + тот же смысл) пропускаются автоматически. Если у слова другое значение — добавится отдельной карточкой."
                   FontSize="13" TextColor="#8A8378" />

            <Editor x:Name="ImportEditor"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="180" />

            <Button Text="📥 Импортировать слова"
                    Clicked="OnImportClicked"
                    BackgroundColor="#2E6F65"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="48" />

            <Label x:Name="ResultLabel"
                   FontSize="14"
                   TextColor="#2B2B2B" />

            <BoxView HeightRequest="1" BackgroundColor="#EAE3D6" Margin="0,10" />

            <Label Text="Текущий список (для ИИ)" FontAttributes="Bold" FontSize="16" TextColor="#2B2B2B" />
            <Label Text="Скопируйте этот JSON и приложите к запросу ИИ — тогда он увидит, какие слова уже есть, и не будет предлагать повторы."
                   FontSize="13" TextColor="#8A8378" />

            <Button Text="📋 Скопировать текущий список"
                    Clicked="OnCopyExportClicked"
                    BackgroundColor="#C9A227"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="48" />

            <Editor x:Name="ExportEditor"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="180" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>