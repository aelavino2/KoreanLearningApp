<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KoreanLearningApp.Views.ImportExportPage" Title="Импорт / Экспорт слов" BackgroundColor="#FBF7F0">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Импорт слов из файла" FontAttributes="Bold" FontSize="17" TextColor="#2B2B2B" />
            <Label Text="Выберите JSON-файл со словами (например, сгенерированный ИИ). Точные дубликаты пропускаются автоматически — если у слова другое значение, оно добавится отдельной карточкой." FontSize="13" TextColor="#8A8378" />
            <Button Text="Выбрать файл и импортировать" Command="{Binding ImportCommand}" BackgroundColor="#2E6F65" TextColor="White" CornerRadius="12" HeightRequest="48" />
            <Label Text="{Binding ResultText}" FontSize="14" TextColor="#2B2B2B" />
            <BoxView HeightRequest="1" BackgroundColor="#EAE3D6" Margin="0,10" />
            <Label Text="Экспорт текущего словаря" FontAttributes="Bold" FontSize="17" TextColor="#2B2B2B" />
            <Label Text="Сохранит все текущие слова в JSON-файл, который можно передать ИИ, чтобы он видел ваш словарь и не предлагал повторы." FontSize="13" TextColor="#8A8378" />
            <Button Text="Сохранить в файл" Command="{Binding ExportCommand}" BackgroundColor="#C9A227" TextColor="White" CornerRadius="12" HeightRequest="48" />
            <BoxView HeightRequest="1" BackgroundColor="#EAE3D6" Margin="0,10" />
            <Label Text="Автосохранение" FontAttributes="Bold" FontSize="17" TextColor="#2B2B2B" />
            <Label Text="{Binding BackupPathText}" FontSize="13" TextColor="#8A8378" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
