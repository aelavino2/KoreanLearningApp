<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.ImportExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.ViewModels"
    x:DataType="vm:ImportExportViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,18,24,4" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource LogoBadgeStyle}">
                <Image Source="logo_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Import &amp; Export" Style="{StaticResource PageTitleStyle}" VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="24,14,24,0" Spacing="14">

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">
                    <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="{StaticResource ColorPoliteBg}" Padding="10" HorizontalOptions="Start">
                        <Image Source="import_export_icon.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Экспорт слов" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryDark}" />
                    <Label Text="Сохраните все ваши слова в JSON файл" FontSize="13" TextColor="{StaticResource ColorMuted}" />
                    <Button Text="Экспортировать (JSON)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExportCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="12">
                    <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="{StaticResource ColorFormalBg}" Padding="10" HorizontalOptions="Start">
                        <Image Source="import_export_icon.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" />
                    </Border>
                    <Label Text="Импорт слов" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource ColorPrimaryDark}" />
                    <Label Text="Загрузите слова из JSON файла" FontSize="13" TextColor="{StaticResource ColorMuted}" />
                    <Button Text="Импортировать (JSON)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ImportCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <Border Grid.Row="2" Style="{StaticResource TabBarBorderStyle}">
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="words_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Words" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToWordsCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="practice_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Practice" Style="{StaticResource TabIconLabelStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToPracticeCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="import_export_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Import" Style="{StaticResource TabIconLabelActiveStyle}" />
                    <BoxView Grid.Row="0" WidthRequest="4" HeightRequest="4" CornerRadius="2" BackgroundColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-8" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToImportExportCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Image Grid.Row="0" Source="star_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Text="Saved" Style="{StaticResource TabIconLabelStyle}" Margin="0,4,0,0" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSavedCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
