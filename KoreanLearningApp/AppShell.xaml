<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KoreanLearningApp.AppShell"
    xmlns:views="clr-namespace:KoreanLearningApp.Views"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="KoreanLearningApp"
    Shell.TabBarBackgroundColor="{StaticResource ColorCard}"
    Shell.TabBarTitleColor="{StaticResource ColorPrimary}"
    Shell.TabBarUnselectedColor="{StaticResource ColorMuted}"
    Shell.TabBarForegroundColor="{StaticResource ColorPrimary}">

    <Shell.Resources>
        <ResourceDictionary>

            <Style x:Key="WordsTabStyle" TargetType="Tab">
                <Style.Triggers>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="False">
                        <Setter Property="Icon" Value="words_icon.png" />
                    </Trigger>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="True">
                        <Setter Property="Icon" Value="words_icon_active.png" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PracticeTabStyle" TargetType="Tab">
                <Style.Triggers>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="False">
                        <Setter Property="Icon" Value="practice_icon.png" />
                    </Trigger>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="True">
                        <Setter Property="Icon" Value="practice_icon_active.png" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ImportExportTabStyle" TargetType="Tab">
                <Style.Triggers>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="False">
                        <Setter Property="Icon" Value="import_export_icon.png" />
                    </Trigger>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="True">
                        <Setter Property="Icon" Value="import_export_icon_active.png" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SavedTabStyle" TargetType="Tab">
                <Style.Triggers>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="False">
                        <Setter Property="Icon" Value="star_icon.png" />
                    </Trigger>
                    <Trigger TargetType="Tab" Property="IsChecked" Value="True">
                        <Setter Property="Icon" Value="star_icon_active.png" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Words" Route="WordsPage" Style="{StaticResource WordsTabStyle}">
            <ShellContent ContentTemplate="{DataTemplate views:WordsPage}" />
        </Tab>
        
        <Tab Title="Import" Route="ImportExportPage" Style="{StaticResource ImportExportTabStyle}">
            <ShellContent ContentTemplate="{DataTemplate views:ImportExportPage}" />
        </Tab>
    </TabBar>
</Shell>