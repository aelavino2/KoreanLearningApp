<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KoreanLearningApp.Views.WordsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KoreanLearningApp.Presentation.ViewModels;assembly=KoreanLearningApp.Presentation"
    x:DataType="vm:WordsViewModel"
    BackgroundColor="{StaticResource ColorBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">


        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="24,18,24,4" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource LogoBadgeStyle}">
                <Image Source="logo_icon.png" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="Korean Dictionary" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding LoadedWordsText}" Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>
        </Grid>


        <VerticalStackLayout Grid.Row="1" Margin="24,14,24,14" Spacing="12">
            <Border Style="{StaticResource SearchBarBorderStyle}">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Grid.Column="0" Source="search_icon.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" VerticalOptions="Center" Margin="0,0,10,0" />
                    <Entry Grid.Column="1" Placeholder="Search for Words" Text="{Binding SearchText}" Style="{StaticResource SearchEntryStyle}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Grid.Column="0" Spacing="8">
                    <Border Style="{StaticResource ModeChipBorderStyle}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsInfiniteScroll}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Страницы" Style="{StaticResource ModeChipLabelStyle}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsInfiniteScroll}" Value="False">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UsePagingCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Style="{StaticResource ModeChipBorderStyle}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsInfiniteScroll}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Лента" Style="{StaticResource ModeChipLabelStyle}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsInfiniteScroll}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseInfiniteScrollCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <Picker Grid.Column="2"
                        Title="Сортировка"
                        ItemsSource="{Binding SortOptions}"
                        ItemDisplayBinding="{Binding Title, x:DataType=vm:WordSortOption}"
                        SelectedItem="{Binding SelectedSort}"
                        Style="{StaticResource SortPickerStyle}" />
            </Grid>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding HasTagFilters}">
                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource ModeChipBorderStyle}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasSelectedTags}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Все темы" Style="{StaticResource ModeChipLabelStyle}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasSelectedTags}" Value="False">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearTagsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding TagFilters}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagFilterViewModel">
                                <Border Style="{StaticResource ModeChipBorderStyle}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Title}" Style="{StaticResource ModeChipLabelStyle}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleTagCommand, Source={RelativeSource AncestorType={x:Type vm:WordsViewModel}}, x:DataType=vm:WordsViewModel}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>


        <CollectionView Grid.Row="2"
                x:Name="WordsCollectionView"
                ItemsSource="{Binding Words}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureFirstItem"
                Margin="24,0,24,0"
                RemainingItemsThreshold="{Binding RemainingItemsThreshold}"
                RemainingItemsThresholdReachedCommand="{Binding ScrolledToEndCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource ColorPrimary}" Margin="0,12" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WordItemViewModel">
                    <Border Style="{StaticResource ListCardBorderStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding Korean}" Style="{StaticResource WordKoreanStyle}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Border Style="{StaticResource TagPillBorderStyle}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Ellipse Style="{StaticResource TagPillDotStyle}" />
                                            <Label Text="{Binding PartOfSpeechDisplay}" Style="{StaticResource TagPillLabelStyle}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Style="{StaticResource TopikChipBorderStyle}" IsVisible="{Binding HasTopikLevel}">
                                        <Label Text="{Binding TopikLevel, StringFormat='TOPIK {0}'}" Style="{StaticResource TopikChipLabelStyle}" />
                                    </Border>
                                    <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding TagTitles}" IsVisible="{Binding HasTags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Style="{StaticResource TopikChipBorderStyle}">
                                                    <Label Text="{Binding .}" Style="{StaticResource TopikChipLabelStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border Grid.Column="1" Style="{StaticResource RoundIconButtonStyle}" VerticalOptions="Center">
                                <Image Source="chevron_right_icon.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference WordsCollectionView}, Path=BindingContext.OpenWordDetailCommand}"
                                CommandParameter="{Binding Word}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Padding="24,10,24,10" IsVisible="{Binding IsPaginationVisible}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Text="&#8592;" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        FontSize="16" CornerRadius="13"
                        BackgroundColor="{StaticResource ColorChipBg}"
                        TextColor="{StaticResource ColorPrimaryDark}" />

                <Label Grid.Column="1"
                       Text="{Binding PageIndicatorText}"
                       TextColor="{StaticResource ColorPrimaryDark}"
                       FontSize="14" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />

                <Button Grid.Column="2"
                        Text="&#8594;"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoToNextPage}"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        FontSize="16" CornerRadius="13"
                        BackgroundColor="{StaticResource ColorPrimary}"
                        TextColor="White" />
            </Grid>

            <Label Grid.Row="1"
                   Text="Долистайте список до конца, чтобы перейти дальше"
                   FontSize="11" TextColor="{StaticResource ColorMuted}"
                   HorizontalOptions="Center" Margin="0,6,0,0"
                   IsVisible="{Binding CanGoToNextPage, Converter={StaticResource InverseBoolConverter}}" />
        </Grid>
    </Grid>
</ContentPage>
